# ==========================================
# APPLICATION
# ==========================================
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# ==========================================
# DATABASE (PostgreSQL / Prisma) — Phase 3
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_interview_platform?schema=public

# ==========================================
# REDIS (Cache / BullMQ Queue)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# AUTH — Phase 4
# ==========================================
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

BCRYPT_SALT_ROUNDS=12
OTP_EXPIRY_MINUTES=10

# ==========================================
# EMAIL (OTP / Notifications)
# ==========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AI Interview Platform <no-reply@aiinterview.dev>"

# ==========================================
# OBJECT STORAGE (Resumes / Audio / Certificates)
# ==========================================
S3_ENDPOINT=
S3_BUCKET=ai-interview-platform
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ==========================================
# AI PROVIDERS — Phase 8 / 9 / 10
# ==========================================
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
WHISPER_API_KEY=
HUGGINGFACE_API_KEY=

# ==========================================
# CODE EXECUTION SANDBOX — Phase 11
# ==========================================
JUDGE_API_URL=
JUDGE_API_KEY=

# ==========================================
# RATE LIMITING
# ==========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100
