# NOTE: the project's actual Docker builds (docker/frontend.Dockerfile) use
# the PROJECT ROOT as build context, where the root .dockerignore is what
# Docker actually reads — this file only applies if someone builds
# directly from within frontend/ as an alternate, non-monorepo-aware path.
node_modules
.next
out
.env.local
*.log
.DS_Store
playwright-report
test-results
